# Nada acá es obligatorio para el login — a diferencia de versiones
# anteriores de backend-core, ya no hace falta ningún proyecto de Firebase
# ni configurar un email permitido. El acceso lo controla un token propio
# que genera `asterion local serve` (el CLI) la primera vez que corre,
# guardado en el directorio de config del usuario (~/Library/Application
# Support/asterion en macOS, ~/.config/asterion en Linux, %AppData%\asterion
# en Windows — ver app/config.py:_user_config_dir) — ver
# asterion-core/internal/localauth y app/auth.py.

# Asterion Cloud, para refrescar la tabla de precios en vivo cuando hay
# sesión de `asterion cloud login`. No es obligatorio: sin esto Core sigue
# funcionando con la tabla pública embebida.
CLOUD_API_BASE_URL=http://localhost:8000
PRICING_REFRESH_MINUTES=60

# 0 = elegir automáticamente un puerto libre (recomendado, ver
# `asterion local serve`). Fijalo si preferís un puerto estable.
BACKEND_CORE_PORT=0
BACKEND_CORE_HOST=127.0.0.1

CORS_ORIGINS=http://localhost:5173
FRONTEND_DIST_PATH=

# Rate limit de POST /api/auth/token (ver app/auth.py). Defaults: 5
# intentos fallidos cada 5 minutos por IP (bloqueo creciente si insiste
# después de cada bloqueo), 20 intentos fallidos agregando TODAS las IPs
# en la misma ventana antes de bloquear el login entero por 15 minutos
# (defensa contra alguien rotando de IP para esquivar el límite por IP).
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_GLOBAL_ATTEMPTS=20
LOGIN_RATE_LIMIT_GLOBAL_LOCKOUT_SECONDS=900

# Lista blanca opcional de IPs/CIDR que pueden intentar loguearse — vacía
# (default) = sin restricción. Ejemplo: LOGIN_ALLOWED_IPS=192.168.1.0/24,203.0.113.7
LOGIN_ALLOWED_IPS=

# Prender SOLO si hay un reverse proxy real y confiable delante (nginx,
# Cloudflare Tunnel, etc.) — lee la IP del cliente de X-Forwarded-For en vez
# de la conexión TCP directa. Prenderlo sin un proxy real de por medio deja
# que cualquiera falsee ese header y esquive el rate limit por completo.
TRUST_PROXY_HEADERS=false
